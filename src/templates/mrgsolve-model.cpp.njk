$PROB
# Model: `{{ id }}`
  - Title: {{ id }}
  - Notes: Generated automatically from platform with Heta compiler
  - Source: Heta compiler

# Demo
```{r,echo=TRUE}
  ev(amt=10) %>% mrgsim %>% plot
```

$SET end=120, delta=0.1, hmax=0.01, hmin=0.0, rtol=1e-3, atol=1e-6

$PARAM @annotated
// constants
{%- for constant in constants %}
{{ constant.id }} : {{ constant.value }} : {{ constant.title | default('-') }}
{%- endfor %}
// events active
{%- for evt in timeEvents %}
{{ evt.id }}__active__ : {{ '1' if evt.active==true else '0' }} : -
{%- endfor %}
{%- for evt in events %}
{{ evt.id }}__active__ : {{ '1' if evt.active==true else '0' }} : -
{%- endfor %}

$INIT @annotated
// dynamic states
{%- for state in dynamic %}
{{ state.id }} : {{ state.initial if state.initial is number else 0.0 }} : {{ state.title | default('-') }}
{%- endfor %}

$PREAMBLE
// static states
{%- for state in static %}
double {{ state.id }} = 0.0; // {{ state.title | default('-') }}
{%- endfor %}
// triggers
{%- for event in events %}
bool {{ event.id }}__pull__ = false;
int {{ event.id }}__charge__ = 0;
{%- endfor %}

$MAIN
// dynamic states initializations
{%- for state in dynamic %}
{%- if state.initial is not number %}
{{ state.id }}_0 = {{ state.initial.expr }};
{%- endif %}
{%- endfor %}
if (NEWIND <= 1) {
// static states initializations
{%- for state in static %}
{{ state.id }} = {{ state.initial if state.initial is number else state.initial.expr }};
{%- endfor %}
// triggers
{%- for event in events %}
{{ event.id }}__pull__ = {{ not event.trigger.atStart }};
{{ event.id }}__charge__ = 0;
{%- endfor %}
// time events
{%- for event in timeEvents %}
self.mevent({{ event.trigger.start if event.trigger.start is number else event.trigger.start.expr }}, {{ timeEventIndex[event.id] }});
{%- endfor %}
}

$ODE
// assignments
{%- for assignment in assignments %}
double {{ assignment.id }} = {{ assignment.rhs if assignment.rhs is number else assignment.rhs.expr }}; // {{ assignment.title | default('-') }}
{%- endfor %}
// triggers
{%- for event in events %}
bool {{ event.id }}__trigger__ = ({{ event.trigger.rhs if event.trigger.rhs is number else event.trigger.rhs.expr }}){{ ' >= 0.0' if event.trigger.type == 'crossing'}};
if ({{ event.id }}__trigger__ && !{{ event.id }}__pull__ && {{ event.id }}__active__) {
  {{ event.id }}__pull__ = true;
  {{ event.id }}__charge__++;
}
if (!{{ event.id }}__trigger__) {
  {{ event.id }}__pull__ = false;
}
{%- endfor %}
// derivatives
{%- for state in dynamic %}
dxdt_{{ state.id }} = {{ state.derivative if state.derivative is number else state.derivative.expr }};
{%- endfor %}

$CAPTURE @annotated
{%- for observable in observables %}
{%- if dynamicStatesIndex[observable.symbol] is not defined %}{# exclude dynamic states #}
{{ observable.symbol }} : {{ observable.title | default('-') }}
{%- endif %}
{%- endfor %}

{% if timeEvents | length > 0 or events | length > 0 -%}
$TABLE
{%- for event in timeEvents %}
// {{ event.id  }} // {{ event.title | default('-') }}
if ({{ event.id }}__active__ && EVID=={{ timeEventIndex[event.id] }}) {
  {%- for action in event.actions %}
  {%- if dynamicStatesIndex[action.state] is defined %} {# for dynamic #}
  {%- set evtId = 'evt_' + action.state + '_' %}
  mrg::evdata {{ evtId }}(TIME, 8);
  {{ evtId }}.amt = {{ action.rhs.expr }};
  {{ evtId }}.cmt = {{ dynamicStatesIndex[action.state] }};
  {{ evtId }}.now = true;
  self.mevector.push_back({{ evtId }});
  {%- else %} {# for static #}
  {{ action.state }} = {{ action.rhs.expr }};
  {%- endif %}
  {%- endfor %}
  {%- if event.trigger.period is defined %}
  // next event
  {% if event.trigger.stop is defined -%}
  if (TIME < {{ event.trigger.stop }}) {% endif -%}
  self.mevent(TIME + {{ event.trigger.period }}, {{ timeEventIndex[event.id] }});{% endif %}
}
{%- endfor %}

{%- for event in events %}
// {{ event.id }} // {{ event.title | default('-') }}
// XXX: the problem here is that amt updates by the same amount each time
for (int {{ event.id }}__i__ = 0; {{ event.id }}__i__ < {{ event.id }}__charge__; {{ event.id }}__i__++) {
  {%- for action in event.actions %}
  {%- if dynamicStatesIndex[action.state] is defined %} {# for dynamic #}
  {%- set evtId = 'evt_' + action.state + '_' %}
  mrg::evdata {{ evtId }}(TIME, 8);
  {{ evtId }}.amt = {{ action.rhs.expr }};
  {{ evtId }}.cmt = {{ dynamicStatesIndex[action.state] }};
  {{ evtId }}.now = true;
  self.mevector.push_back({{ evtId }});
  {%- else %} {# for static #}
  {{ action.state }} = {{ action.rhs.expr }};
  {%- endif %}
  {%- endfor %}
}
{{ event.id }}__charge__ = 0;

{%- endfor %}
{% endif %}