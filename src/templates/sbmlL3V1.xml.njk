{% extends "./sbml.xml.njk" %}

{% block sbmlHeader %}
  xmlns="http://www.sbml.org/sbml/level3/version1/core" 
  xmlns:xhtml="http://www.w3.org/1999/xhtml" 
  level="3" version="1"
{%- endblock %}

{% block modelHeader %}
  {%- if population.get('t').units is defined %}
    timeUnits="{{ population.get('t').unitsHash() }}"
  {%- endif %}
{%- endblock %}

{% block timeEventTriggerAttributes %} initialValue="false"{% endblock %}

{% block timeEventPriority %}
        {% if event.priority is defined %}
        <priority>
          <math xmlns="http://www.w3.org/1998/Math/MathML"><cn>{{ event.priority }}</cn></math>
        </priority>
        {% endif %}
{% endblock %}

{% block cEventTriggerAttributes %} initialValue="{{ 'false' if event.atStart else 'true' }}"{% endblock %}

{% block cEventPriority %}
        {% if event.priority is defined %}
        <priority>
          <math xmlns="http://www.w3.org/1998/Math/MathML"><cn>{{ event.priority }}</cn></math>
        </priority>
        {% endif %}
{% endblock %}

{% block dEventTriggerAttributes %} initialValue="{{ 'false' if event.atStart else 'true' }}"{% endblock %}

{% block dEventPriority %}
        {% if event.priority is defined %}
        <priority>
          <math xmlns="http://www.w3.org/1998/Math/MathML"><cn>{{ event.priority }}</cn></math>
        </priority>
        {% endif %}
{% endblock %}
