/*
  template file for creating platform
*/
//include ./qsp-units.heta;
//include ./qsp-functions.heta;

c1 @Compartment .= 1;
s1 @Species {compartment: c1} .= 10;
s2 @Species {compartment: c1} .= 0;

r1 @Reaction {actors: s1=s2} := k1 * s1 * c1;

// normal, Infinity, NaN
k1 @Const = 0.1;
k2 @Const = Infinity;
k3 @Const = NaN;

// normal, Infinity, NaN
p1 @Record := 0.1 * s1;
p2 @Record := Infinity * s1;
p3 @Record := NaN * s1;

// Global constants
p4 @Record := pi * s1;
p5 @Record := exponentiale * s1;
